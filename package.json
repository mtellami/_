{
  "name": "openapi-mcp-bridge",
  "version": "0.1.0",
  "description": "Dynamic OpenAPI-to-MCP Bridge Engine — an MCP server that ingests OpenAPI 3.x specs and exposes validated tools to LLMs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "openapi-mcp-bridge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fmt": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.2",
    "prettier": "^3.6.0",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3"
  }
}
